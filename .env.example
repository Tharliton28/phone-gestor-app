# Supabase — preencha com os dados do seu projeto
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL da landing page (marketing). Ex: https://phonegestor.com.br
VITE_LANDING_URL=https://phonegestor.com.br

# No repo da landing (site-config.js), APP_URL deve apontar para este app.
# Ex.: https://app.phonegestor.com.br → /login

# Token Focus NFe: NÃO vai no Vite.
# Salve por loja em Configurações → Fiscal (tabela loja_fiscal_secrets via RPC).
# A Edge Function emitir-nfce usa SUPABASE_SERVICE_ROLE_KEY no servidor.
